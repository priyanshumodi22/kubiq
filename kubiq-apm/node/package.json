{
    "name": "kubiq-apm",
    "version": "1.1.0",
    "description": "Unified OpenTelemetry APM wrapper for Kubiq",
    "main": "index.js",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/priyanshumodi22/kubiq.git",
        "directory": "kubiq-apm/node"
    },
    "files": [
        "index.js",
