# Copy this file outside the repository as kubiq-runtime.secret.yaml, replace
# every value, and create it only on the k3s node. Never commit real values.
apiVersion: v1
kind: Secret
metadata:
  name: kubiq-runtime
  namespace: kubiq-system
type: Opaque
stringData:
  # ── Database (MongoDB) ──
  DB_URI: 'mongodb+srv://replace-with-your-private-uri'

  # ── Auth ──
  JWT_SECRET: 'replace-with-a-long-random-secret'
  # Shared bearer token for Fluent Bit and OTLP/Zipkin ingestion. Generate with:
  # node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
  KUBIQ_INGESTION_TOKEN: 'replace-with-a-long-random-ingestion-token'

  # ── WebAuthn / Biometrics ──
  RP_ID: priyanshumodi.in
  ORIGIN: https://priyanshumodi.in

  # ── AI ──
  AI_API_KEY: 'your_ai_api_key_here'
  # Required only for the in-product Profile > Kubi AI configuration. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
  KUBI_AI_CONFIG_ENCRYPTION_KEY: 'base64_encoded_32_byte_key'

  # ── License ──
  KUBIQ_LICENSE_KEY: 'your_polar_license_key_here'
