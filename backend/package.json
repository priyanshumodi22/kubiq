{
  "name": "kubiq-backend",
  "version": "1.0.1",
  "description": "kubiq Dashboard Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/server.ts",
    "build": "tsc",
    "build:ncc": "ncc build dist/server.js -o build --minify --no-cache --no-source-map-register",
    "start": "node dist/server.js",
    "test": "jest",
    "test:coverage": "jest --runInBand --coverage --coverageReporters=lcov --coverageReporters=text-summary",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "keywords": [],
  "author": "Priyanshu Modi",
  "license": "Elastic-2.0",
  "bin": "dist/server.js",
  "pkg": {
    "assets": [
      "views/**/*"
    ],
    "scripts": [
      "node_modules/axios/dist/node/axios.cjs",
      "node_modules/@peculiar/webcrypto/**/*.js"
    ],
    "targets": [
      "node18-linux-x64",
      "node18-linux-arm64"
    ]
  },
  "dependencies": {
    "@clickhouse/client": "^1.19.0",
    "@kubernetes/client-node": "^1.4.0",
    "@peculiar/webcrypto": "^1.5.0",
    "@simplewebauthn/server": "^13.2.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/glob": "^8.1.0",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "chokidar": "^5.0.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "glob": "^13.0.0",
    "helmet": "^8.1.0",
    "js-yaml": "^5.4.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "morgan": "^1.10.1",
    "mysql2": "^3.24.5",
    "node-cache": "^5.1.2",
    "nodemailer": "^10.1.0",
    "simple-statistics": "^7.8.8",
    "socket.io": "^4.8.3",
    "systeminformation": "^5.33.15"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "engine.io": "6.6.11",
    "socket.io-parser": "4.2.7",
    "ws": "8.22.0",
    "ip-address": "10.7.4",
    "brace-expansion": "5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "globals": "14.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.0.3",
    "@types/nodemailer": "^7.0.5",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@vercel/ncc": "^0.38.3",
    "eslint": "^9.39.2",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "pkg": "^5.8.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
