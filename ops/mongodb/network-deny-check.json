{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "mongodb-network-deny-check",
    "namespace": "default"
  },
  "spec": {
    "automountServiceAccountToken": false,
    "restartPolicy": "Never",
    "activeDeadlineSeconds": 60,
    "containers": [
      {
        "name": "check",
        "image": "node:22-bookworm-slim",
        "command": [
          "node",
          "-e",
          "const s=require('net').connect(27017,'mongodb.mongodb-system.svc.cluster.local');s.once('connect',()=>{console.error('Unexpected network access');process.exit(1)});s.setTimeout(5000,()=>{console.log(JSON.stringify({unrelatedNamespaceBlocked:true}));s.destroy();process.exit(0)});s.once('error',e=>{if(['ECONNREFUSED','EHOSTUNREACH','ENETUNREACH','ETIMEDOUT'].includes(e.code)){console.log(JSON.stringify({unrelatedNamespaceBlocked:true,code:e.code}));process.exit(0)}console.error(e.code);process.exit(1)});"
        ],
        "resources": {
          "requests": {
            "cpu": "5m",
            "memory": "16Mi"
          },
          "limits": {
            "cpu": "100m",
            "memory": "64Mi"
          }
        },
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 1000,
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          }
        }
      }
    ]
  }
}