NODE_ENV=production
PORT=3001
BACKEND_CONTEXT_PATH=/kubiq-api
FRONTEND_CONTEXT_PATH=/kubiq
FRONTEND_DNS=http://localhost:3001
CORS_ORIGIN=http://localhost:3001
NATIVE_AUTH_ENABLED=true
JWT_SECRET=replace-with-a-unique-random-secret-before-starting
DB_TYPE=mongo
DB_URI=mongodb://127.0.0.1:27017/kubiq
KUBIQ_TRACING_ENABLED=false
